SESSION_SECRET=

# --- Email notifications for new contact messages ---
# Leave SMTP_HOST empty to turn emails off.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=a 16-character Google "App password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who receives the notifications
NOTIFY_EMAIL=
# Sender shown on the email (defaults to SMTP_USER)
MAIL_FROM=

# Set to true to print emails in the server terminal instead of sending them
MAIL_DRY_RUN=false
