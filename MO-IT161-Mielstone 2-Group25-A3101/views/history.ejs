<%- include('partials/header') %>
        <section>
            <h2>My Past Results</h2>
            <p>Results are saved on the server and linked to this browser only. You can delete any of them at any time.</p>

            <% if (deleted) { %><div class="alert alert-success" role="status">Result deleted.</div><% } %>

            <% if (records.length === 0) { %>
                <p><em>You haven't completed an assessment yet.</em></p>
                <a href="/assessment"><button type="button">Start Assessment</button></a>
            <% } else { %>
            <div class="table-wrap">
                <table class="history">
                    <thead>
                        <tr><th scope="col">Date</th><th scope="col">Score</th><th scope="col">Risk</th><th scope="col">Actions</th></tr>
                    </thead>
                    <tbody>
                    <% records.forEach(function (r) { %>
                        <tr>
                            <td><%= formatDate(r.createdAt) %></td>
                            <td><%= r.score %>/<%= r.total %></td>
                            <td class="risk-<%= r.riskLevel.toLowerCase() %>"><strong><%= r.riskLevel %></strong></td>
                            <td class="actions">
                                <a href="/results/<%= r.id %>">View</a>
                                <form method="post" action="/history/<%= r.id %>/delete" class="inline-form" data-confirm="Delete this result?">
                                    <button type="submit" class="btn-link">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </section>
<%- include('partials/footer') %>
