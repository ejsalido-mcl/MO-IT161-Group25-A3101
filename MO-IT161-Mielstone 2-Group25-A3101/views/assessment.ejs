<%- include('partials/header') %>
        <section>
            <h2>Start Your Assessment</h2>
            <p>Answer the questions below about your Wi-Fi setup. <a href="/history">View my past results</a></p>

            <% if (errors.length) { %>
            <div class="alert alert-error" role="alert">
                <strong>Please fix the following:</strong>
                <ul>
                    <% errors.forEach(function (e) { %><li><a href="#<%= e.field %>"><%= e.message %></a></li><% }); %>
                </ul>
            </div>
            <% } %>

            <form id="assessment-form" method="post" action="/assessment">
                <% questions.forEach(function (q, i) {
                    const hasError = errors.some(function (e) { return e.field === q.id; }); %>
                <fieldset id="<%= q.id %>" class="question<%= hasError ? ' has-error' : '' %>">
                    <legend><%= i + 1 %>. <%= q.text %></legend>
                    <label class="radio"><input type="radio" name="<%= q.id %>" value="yes"<%= values[q.id] === 'yes' ? ' checked' : '' %>> Yes</label>
                    <label class="radio"><input type="radio" name="<%= q.id %>" value="no"<%= values[q.id] === 'no' ? ' checked' : '' %>> No</label>
                </fieldset>
                <% }); %>

                <button type="submit">Calculate My Risk Score</button>
                <button type="button" id="reset-btn" class="btn-secondary">Reset</button>
            </form>
        </section>
<%- include('partials/footer') %>
