<%- include('partials/header') %>
        <section>
            <h2>Contact Us</h2>
            <p>Have a question or need help securing your network? Send us a message.</p>

            <% if (sent) { %>
            <div class="alert alert-success" id="contact-message" role="status">
                Thank you! Your message has been received. We'll get back to you within 24 hours.
            </div>
            <% } %>

            <% if (errors.length) { %>
            <div class="alert alert-error" role="alert">
                <strong>Please fix the following:</strong>
                <ul>
                    <% errors.forEach(function (e) { %><li><a href="#<%= e.field %>"><%= e.message %></a></li><% }); %>
                </ul>
            </div>
            <% } %>

            <form id="contact-form" method="post" action="/contact">
                <label for="name">Your Name:</label>
                <input type="text" id="name" name="name" maxlength="100" required placeholder="Enter your name" value="<%= values.name || '' %>">

                <label for="email">Email Address:</label>
                <input type="email" id="email" name="email" maxlength="254" required placeholder="Enter your email" value="<%= values.email || '' %>">

                <label for="subject">Subject:</label>
                <input type="text" id="subject" name="subject" maxlength="150" required placeholder="What is this about?" value="<%= values.subject || '' %>">

                <label for="message">Message:</label>
                <textarea id="message" name="message" rows="5" maxlength="2000" required placeholder="Describe your concern or question."><%= values.message || '' %></textarea>
                <p></p>
                <button type="submit">Send Message</button>
            </form>
        </section>

        <section>
            <h2>Other Ways to Reach Us</h2>
            <ul>
                <li>Email: support@netguard.com</li>
                <li>Response time: Within 24 hours</li>
                <li>Hours: Monday–Friday, 9AM–5PM</li>
            </ul>
        </section>
<%- include('partials/footer') %>
